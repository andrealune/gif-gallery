# Server
NODE_ENV=development
PORT=3001

# CORS: comma-separated list of allowed origins (use * to allow all in development)
CORS_ORIGIN=http://localhost:3000

# Database (PostgreSQL)
# Either provide a full connection string...
DATABASE_URL=postgres://gif_gallery:gif_gallery@localhost:5432/gif_gallery
# ...or the individual parts below (used if DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gif_gallery
DB_USER=gif_gallery
DB_PASSWORD=gif_gallery
DB_SSL=false
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

# AI image generation (OpenAI DALL-E) - see src/services/ai (L42-421)
# Required in production; the process will still boot in dev/test without it,
# but any call to the image client will fail with OpenAIConfigError.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_IMAGE_MODEL=dall-e-3
OPENAI_IMAGE_SIZE=1024x1024
OPENAI_IMAGE_QUALITY=standard
OPENAI_REQUEST_TIMEOUT_MS=60000
OPENAI_MAX_RETRIES=3
OPENAI_RETRY_BASE_DELAY_MS=500
# Client-side cap on outgoing requests per minute (independent of OpenAI's own limits)
OPENAI_RATE_LIMIT_RPM=50
# Optional soft spend cap, in USD, enforced before a request is sent (unset = no cap)
OPENAI_COST_BUDGET_USD=

# Image-to-GIF conversion pipeline - see src/services/gif (L42-422)
# Requires ffmpeg (and ffprobe) on PATH; override the paths below if they
# aren't, e.g. in a container image that installs them somewhere else.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# '' (default) means "use the OS temp directory" for intermediate files.
GIF_TMP_DIR=
GIF_DEFAULT_WIDTH=480
# Unset by default - see the comment in src/config/env.ts for the fallback behavior.
GIF_DEFAULT_HEIGHT=
GIF_DEFAULT_FPS=10
# GIF loop count: 0 = loop forever, -1 = play once, N > 0 = loop N extra times.
GIF_DEFAULT_LOOP=0
GIF_DEFAULT_DITHER=sierra2_4a
# Ken Burns (pan/zoom) animation applied when converting a single still image.
GIF_KEN_BURNS_ZOOM=1.15
GIF_KEN_BURNS_DURATION_MS=3000
GIF_CONVERSION_TIMEOUT_MS=30000
GIF_MAX_INPUT_BYTES=26214400
# Max number of conversions convertBatch() runs at once by default.
GIF_BATCH_CONCURRENCY=3

# File storage for generated/third-party GIFs (consumed by later tasks (L42-425))
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./storage
# S3-compatible storage (optional, used when STORAGE_PROVIDER=s3)
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# SEO (consumed by sitemap.xml / robots.txt - L42-433)
# Public origin the site is served from, no trailing slash. Used to build
# absolute URLs in sitemap.xml and the Sitemap: directive in robots.txt.
SITE_URL=http://localhost:3000
