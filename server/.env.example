# Server
NODE_ENV=development
PORT=3001

# CORS: comma-separated list of allowed origins (use * to allow all in development)
CORS_ORIGIN=http://localhost:3000

# Database (PostgreSQL)
# Either provide a full connection string...
DATABASE_URL=postgres://gif_gallery:gif_gallery@localhost:5432/gif_gallery
# ...or the individual parts below (used if DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gif_gallery
DB_USER=gif_gallery
DB_PASSWORD=gif_gallery
DB_SSL=false
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

# AI image/GIF generation (e.g. OpenAI DALL-E) - consumed by later tasks (L42-421)
OPENAI_API_KEY=

# File storage for generated/third-party GIFs (consumed by later tasks (L42-425))
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./storage
# S3-compatible storage (optional, used when STORAGE_PROVIDER=s3)
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
