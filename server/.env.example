# Server
NODE_ENV=development
PORT=3001

# CORS: comma-separated list of allowed origins (use * to allow all in development)
CORS_ORIGIN=http://localhost:3000

# Database (PostgreSQL)
# Either provide a full connection string...
DATABASE_URL=postgres://gif_gallery:gif_gallery@localhost:5432/gif_gallery
# ...or the individual parts below (used if DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gif_gallery
DB_USER=gif_gallery
DB_PASSWORD=gif_gallery
DB_SSL=false
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

# AI image/GIF generation (e.g. OpenAI DALL-E) - consumed by later tasks (L42-421)
OPENAI_API_KEY=
OPENAI_MODEL=dall-e-3
OPENAI_IMAGE_SIZE=1024x1024
OPENAI_REQUEST_TIMEOUT_MS=60000
OPENAI_MAX_RETRIES=3
OPENAI_RETRY_BASE_DELAY_MS=500
OPENAI_RATE_LIMIT_RPM=50
# Soft spend cap enforced client-side before issuing a request. Unset (or <= 0) means "no cap".
OPENAI_COST_BUDGET_USD=

# Image-to-GIF conversion (ffmpeg) - src/services/gif (L42-422)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
GIF_TMP_DIR=
GIF_DEFAULT_WIDTH=480
GIF_DEFAULT_HEIGHT=
GIF_DEFAULT_FPS=10
GIF_DEFAULT_LOOP=0
GIF_DEFAULT_DITHER=sierra2_4a
# Ken Burns (pan/zoom) animation applied when converting a single still image.
GIF_KEN_BURNS_ZOOM=1.15
GIF_KEN_BURNS_DURATION_MS=3000
GIF_CONVERSION_TIMEOUT_MS=30000
GIF_MAX_INPUT_BYTES=26214400
# Max number of conversions convertBatch() runs at once by default.
GIF_BATCH_CONCURRENCY=3

# File storage for generated/third-party GIFs (see server/src/storage and
# infra/terraform/storage). "local" (default) writes to disk and is served
# back by this app at /storage - development only. Use "s3" in staging/prod.
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./storage
STORAGE_PUBLIC_BASE_URL=http://localhost:3001/storage

# S3-compatible storage (used when STORAGE_PROVIDER=s3; also works with
# GCS/MinIO/R2 via S3_ENDPOINT + S3_FORCE_PATH_STYLE)
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# CDN in front of the bucket (e.g. the CloudFront domain output by
# infra/terraform/storage). Used to build the public URL for stored GIFs.
CDN_BASE_URL=

# SEO (consumed by sitemap.xml / robots.txt - L42-433)
# Public origin the site is served from, no trailing slash. Used to build
# absolute URLs in sitemap.xml and the Sitemap: directive in robots.txt.
SITE_URL=http://localhost:3000

# IndexNow (https://www.bing.com/indexnow, L42-435) - lets `npm run
# seo:submit-indexnow` push sitemap URLs straight to Bing/Yandex/Seznam.
# Leave unset until someone actually generates a key there; both the
# /<key>.txt route and the submit script no-op without it.
INDEXNOW_KEY=

# Batch generation scheduler (consumed by src/services/generation - L42-424)
# Off by default; importing the module never has a side effect on its own.
GENERATION_SCHEDULER_ENABLED=false
# Standard 5-field cron expression. Default: daily at 03:00.
# Weekly example: '0 3 * * 1' (every Monday at 03:00).
GENERATION_CRON_SCHEDULE=0 3 * * *
GENERATION_TIMEZONE=UTC
# Max categories generated per run. 0 = every category with an active prompt.
GENERATION_MAX_CATEGORIES_PER_RUN=0
# Also run one batch immediately at process startup, in addition to the cron
# schedule. Leave off in normal operation.
GENERATION_RUN_ON_START=false
# Elasticsearch (GIF search index - src/search, docs/elasticsearch.md - L42-418)
# Local dev: `docker compose up -d elasticsearch` starts a single-node cluster
# at this default, no auth required. Cloud/production: point at the managed
# endpoint (https://...) and set ELASTICSEARCH_API_KEY (preferred) or
# ELASTICSEARCH_USERNAME/PASSWORD.
ELASTICSEARCH_NODE=http://localhost:9200
# Alias the app reads/writes through; the indexing pipeline manages the
# versioned indices (gifs_v1, gifs_v2, ...) behind it - see src/search/pipeline.ts.
ELASTICSEARCH_GIFS_INDEX=gifs
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_TLS_REJECT_UNAUTHORIZED=true
ELASTICSEARCH_REQUEST_TIMEOUT_MS=10000
ELASTICSEARCH_MAX_RETRIES=3
# One shard comfortably covers the 10k-100k document target; replicas default
# to 0 for a single-node local cluster and should be >=1 in production.
ELASTICSEARCH_INDEX_SHARDS=1
ELASTICSEARCH_INDEX_REPLICAS=0
# Rows fetched from Postgres per page while running `npm run search:reindex`
ELASTICSEARCH_REINDEX_BATCH_SIZE=500

# Incremental create/update/delete sync job (src/search/syncJob.ts - L42-419).
# Runs inline in the API process by default alongside the routes above; set
# to false to run it only via the standalone `npm run search:sync` worker.
ELASTICSEARCH_SYNC_ENABLED=true
# How long to wait between polls once a poll comes back with nothing new.
ELASTICSEARCH_SYNC_INTERVAL_MS=5000
# Changed rows fetched from Postgres per page while syncing.
ELASTICSEARCH_SYNC_BATCH_SIZE=200
# On startup, the sync cursor starts this far in the past instead of at "now",
# so changes racing with process startup/restart are still picked up.
ELASTICSEARCH_SYNC_STARTUP_OVERLAP_MS=60000
