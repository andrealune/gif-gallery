# Base URL of the gallery API (server/, see server/src/app.ts - mounted under /api).
# Used both at request-time on the server and directly from the browser (NEXT_PUBLIC_*),
# so it must be reachable from wherever this app is deployed, not just from the Next.js server.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api

# Public origin this app is served from - used to build absolute URLs for metadataBase/Open
# Graph/Twitter tags (og:url, og:image, canonical links). Keep this in sync with SITE_URL in
# server/.env(.example) (used for sitemap.xml/robots.txt) - both should point at the same origin.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Search-console ownership-verification codes (L42-435). Leave both unset until the property is
# actually registered - see lib/config.ts for where each code comes from. Setting one renders the
# corresponding <meta> verification tag on every page; it's otherwise omitted entirely.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
